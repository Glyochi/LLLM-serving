FROM nvcr.io/nvidia/tritonserver:25.06-trtllm-python-py3

ENV CMAKE_POLICY_VERSION_MINIMUM=3.5

COPY ./tensorrtllm_backend/tensorrt_llm/examples/gemma/requirements.txt /requirements.txt
# cant be resolved inside the container from some reason
RUN pip3 install --extra-index-url https://pypi.nvidia.com tensorrt-llm
# Need to be at least 3.5
RUN pip3 install Cmake
RUN pip3 install -r /requirements.txt

COPY ./scripts/build_script.sh ./build_script.sh
COPY ./tensorrtllm_backend/ ./projects/tensorrtllm_backend/

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        nvtop \
        python3 \
        python3-pip \
        procps \
        ca-certificates && \
    # Install awscli using pip
    pip3 install --no-cache-dir awscli && \
    # Clean up apt lists to keep the image size down
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
